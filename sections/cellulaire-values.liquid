<section class="values wrap inset">{% for block in section.blocks %}<article {{ block.shopify_attributes }}>{% render 'cellulaire-icon', name: block.settings.icon %}<h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.description | escape }}</p></article>{% endfor %}</section>

{% schema %}
{
  "name": "Cellulaire values",
  "settings": [],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "science"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Science"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Backed by research and powered by proven ingredients for visible results."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cellulaire values"
    }
  ]
}
{% endschema %}
